pkgname=firmware-oneplus-guacamole
pkgver=1
pkgrel=0
pkgdesc="Firmware for Oneplus 7 Pro"
arch="aarch64"
_carch="arm64"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-ipa
	$pkgname-modem
	$pkgname-slpi
	$pkgname-venus
	$pkgname-wlan
	"

url="https://github.com/PzUI/firmware-mainline-oneplus-guacamole"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="a595ab4318d46fc0029a5aa8f0fcf018799b55e7"
source="
	https://github.com/PzUI/firmware-mainline-oneplus-guacamole/archive/$_commit.tar.gz
	30-gpu-firmware.files
	firmware.files
"
builddir="$srcdir/firmware-mainline-oneplus-guacamole-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-gpu-firmware.files"
}

# OnePlus guacamole boots with secure boot, it can only load signed firmwares.
adreno() {
	pkgdesc="OnePlus guacamole adreno firmware"
	# depends="firmware-qcom-adreno-a650"
	install -Dm644 "$builddir"/a6* -t \
		"$subpkgdir/lib/firmware/qcom/"
}

adsp() {
	pkgdesc="OnePlus guacamole adsp firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/adsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}

cdsp() {
	pkgdesc="OnePlus guacamole cdsp firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/cdsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}
ipa() {
	pkgdesc="OnePlus guacamole ipa firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/ipa* -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}

modem() {
	pkgdesc="OnePlus guacamole modem firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/modem* -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}


slpi() {
	pkgdesc="OnePlus guacamole slpi firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/slpi* -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}

venus() {
	pkgdesc="OnePlus guacamole venus firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus7/venus.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}

wlan() {
	pkgdesc="OnePlus guacamole wlan firmware"

	install -Dm644 "$builddir"/qcom/sm8150/oneplus/wlanmdsp.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm8150/oneplus/guacamole/"
}

sha512sums="
"
